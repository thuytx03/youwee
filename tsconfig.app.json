{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases — @elah/* mirrors vite.config.ts's resolve.alias so tsc/IDE
       resolve the same vendored source as the bundler (see src/vendor/elah).
       Paths are relative to this file; TS 7 removed baseUrl. */
    "paths": {
      "@/*": ["./src/*"],
      "@elah/core": ["./src/vendor/elah/core/src/index.ts"],
      "@elah/editor": ["./src/vendor/elah/editor/src/index.ts"],
      "@elah/timeline": ["./src/vendor/elah/timeline/src/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/vendor/elah/**"]
}
